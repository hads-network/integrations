{
  "name": "hads-react",
  "version": "0.1.0",
  "description": "React and Next.js components for HADS ad slots.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "hads",
    "ads",
    "react",
    "nextjs"
  ],
  "homepage": "https://hads.dev/docs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node test/render.test.mjs && node test/spa.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "next": ">=13.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hads-network/integrations.git",
    "directory": "react"
  },
  "bugs": {
    "url": "https://github.com/hads-network/integrations/issues"
  }
}
